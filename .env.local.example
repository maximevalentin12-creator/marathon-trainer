# Copy to .env.local (local dev) and fill in your values. Never commit .env.local.
# On Vercel, set the same names under Project → Settings → Environment Variables.
# "Public" values are shipped to the browser (they are safe to expose); "server-only" values must never be.

# ── Public (NEXT_PUBLIC_*) — REQUIRED everywhere ─────────────────────────────
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-only ──────────────────────────────────────────────────────────────

# OPTIONAL on Vercel — leave it OUT of Vercel unless you connect Google Calendar.
# The service-role key bypasses row-level security. The app only needs it for the Google Calendar webhook
# (Google sends no user session). Locally it is also handed to scripts/sync_garmin.py.
# The scheduled Garmin sync gets it from a GitHub secret instead (see README).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LOCAL DEV ONLY — never needed on Vercel. Used by scripts/sync_garmin.py when you run a sync or the one-time
# `--login` bootstrap on your own machine. The scheduled GitHub job never uses a password.
GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=your-garmin-password

# OPTIONAL — Google Calendar sync. Skip all four if you do not use it.
# From Google Cloud Console → APIs & Services → Credentials (OAuth client type: "Web application").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g. https://<your-app>/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Public HTTPS base URL of the app (Google requires HTTPS for push-notification webhooks; locally use a tunnel).
APP_BASE_URL=https://your-public-domain.example.com

# OPTIONAL — force "scheduled-only" behaviour (the sync button never spawns Python) outside Vercel.
# On Vercel this is automatic (the VERCEL variable is set by the platform).
# GARMIN_SYNC_MODE=scheduled
