# Copy to .env.local and fill in your values.
# Never commit .env.local.

# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Garmin Connect credentials (used by scripts/sync_garmin.py)
GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Google Calendar OAuth — from Google Cloud Console > APIs & Services > Credentials
# (OAuth client type: "Web application")
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" configured on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Public HTTPS base URL for this app (Google requires HTTPS for push-notification
# webhooks, so in local dev this must point at a tunnel, e.g. ngrok, not localhost).
APP_BASE_URL=https://your-public-domain.example.com
